#!name=VSCO — kiểm thử
#!desc=Trích từ All In One, chưa xác nhận trên thiết bị
#!author=duyvinh09

[Script]
VSCO = type=http-request ^https://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) script-path=__ASSET_BASE__/VSCO.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
