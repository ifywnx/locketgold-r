# An Feature Store — example values only. NEVER commit real keys.
# Default: safe simulated checkout, no money transferred and no product delivered.
STORE_PAYMENTS_MODE=demo
STORE_FULFILLMENT_READY=false
STORE_PRICES_APPROVED=false

# For eventual LIVE checkout only, after testing and rotating disclosed credentials:
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# The exact destination bank account number verified by your payOS channel:
PAYOS_EXPECTED_ACCOUNT_NUMBER=

# Persist this database across Railway deploys/restarts.
# Mount a persistent volume for file: SQLite, or configure a supported remote libSQL URL.
DATABASE_URL=file:./data/app.db
